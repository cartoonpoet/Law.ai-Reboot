# 로컬 Postgres (docker-compose)
# auth-service / user-service 가 schema 파라미터로 스키마를 분리한다
DATABASE_URL_AUTH="postgresql://lawai:lawai_local_pw@localhost:5432/lawai?schema=auth"
DATABASE_URL_USER="postgresql://lawai:lawai_local_pw@localhost:5432/lawai?schema=users"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# 비밀번호 재설정
PASSWORD_RESET_TTL_MIN="30"          # 재설정 토큰 유효 시간(분)
APP_WEB_URL="http://localhost:5173"  # 재설정 링크 / 멘션 이메일 링크에 사용할 웹 앱 주소

# 이메일 알림(Resend, user-service 멘션 이메일)
RESEND_API_KEY=""                       # 비우면 이메일 로그 스텁(실제 발송 안 함) — dev/CI 안전
MAIL_FROM="onboarding@resend.dev"       # 발신 주소. 프로덕션은 Resend 에 검증된 도메인 사용

# 파일 업로드(Cloudflare R2 — S3 호환). 모두 비우면 user-service R2 disabled 모드(503 응답).
# 발급: Cloudflare 대시보드 → R2 → "Manage R2 API Tokens"에서 Object Read+Write 권한 발급.
R2_ACCOUNT_ID=""                        # 32자 account id
R2_ACCESS_KEY_ID=""                     # API token Access Key
R2_SECRET_ACCESS_KEY=""                 # API token Secret
R2_ENDPOINT=""                          # https://<account>.r2.cloudflarestorage.com (또는 커스텀)
R2_BUCKET=""                            # 버킷 이름 (예: legal)
FILE_UPLOAD_SECRET=""                   # presign/confirm uploadToken HMAC. 비우면 JWT_ACCESS_SECRET 사용.
