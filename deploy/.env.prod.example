# 서버 /opt/lawai/.env 에 위치. bootstrap.sh가 강한 시크릿으로 자동 생성한다.
# (수동 작성 시 __CHANGE_ME__ 를 openssl rand -hex 32 값으로 교체)
POSTGRES_USER=lawai
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=lawai

JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

PASSWORD_RESET_TTL_MIN=30
APP_WEB_URL=https://lawai-reboot.kro.kr
