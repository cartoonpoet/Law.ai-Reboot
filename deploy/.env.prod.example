# 서버 /opt/lawai/.env 에 위치. bootstrap.sh가 강한 시크릿으로 자동 생성한다.
# (수동 작성 시 __CHANGE_ME__ 를 openssl rand -hex 32 값으로 교체)
POSTGRES_USER=lawai
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=lawai

JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_DAYS=7
APP_WEB_URL=https://lawai-reboot.kro.kr

# 이메일 발송(Resend) — 멘션·비밀번호 재설정·초대 메일. 비우면 로그 스텁(미발송), 운영에선 발신 도메인 검증 필요
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Cloudflare R2 파일 업로드(presigned URL) — 비우면 503 stub(업로드 비활성)
# 운영 IP를 R2 API Token 화이트리스트에 추가해야 함(Cloudflare → R2 → Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# presign→confirm 사이 단기 업로드 토큰 sign용(64-hex 랜덤, 비우면 JWT_ACCESS_SECRET fallback)
# 생성: openssl rand -hex 32
FILE_UPLOAD_SECRET=__CHANGE_ME__
