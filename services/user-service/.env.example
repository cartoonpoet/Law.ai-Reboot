DATABASE_URL="postgresql://lawai:lawai_local_pw@localhost:5432/lawai?schema=users"
USER_SERVICE_PORT=4002

# 멘션 이메일(Resend)
RESEND_API_KEY=""                       # 비우면 이메일 로그 스텁(실제 발송 안 함) — dev/CI 안전
MAIL_FROM="onboarding@resend.dev"       # 발신 주소. 프로덕션은 Resend 에 검증된 도메인 사용
APP_WEB_URL="http://localhost:5173"     # 멘션 이메일 링크(/contract/:id)에 사용할 웹 앱 주소

# 파일 업로드(Cloudflare R2 — S3 호환). 모두 비우면 R2 disabled — presign/confirm/download 503.
# 발급: Cloudflare 대시보드 → R2 → "Manage R2 API Tokens" → Object Read+Write 권한.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""                          # 보통 https://<account>.r2.cloudflarestorage.com
R2_BUCKET=""                            # 버킷 이름 (예: legal)
FILE_UPLOAD_SECRET=""                   # presign uploadToken HMAC 시크릿(비우면 JWT_ACCESS_SECRET fallback)

# AI 자격증명 암복호화 마스터 키(@lawai/crypto). 32바이트를 base64 인코딩한 값.
# 생성: openssl rand -base64 32
AI_CREDENTIAL_MASTER_KEY=""

# AI 분석 트리거가 호출하는 ai-service (TCP 마이크로서비스)
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=4003
