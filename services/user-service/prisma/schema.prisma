generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["users", "companies", "contracts", "shared"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  contracts           Contract[]

  @@schema("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("users")
}

enum CompanyType {
  company
  individual

  @@schema("companies")
}

model Company {
  id            String      @id @default(uuid())
  type          CompanyType @default(company)
  name          String
  bizNo         String      @unique
  ceo           String?
  phone         String?
  address       String?
  addressDetail String?
  managerName   String?
  managerPhone  String?
  managerEmail  String?
  createdAt     DateTime    @default(now())

  counterparties Counterparty[]

  @@index([name])
  @@schema("companies")
}

enum SecurityLevel {
  top
  secure
  normal

  @@schema("contracts")
}

enum ReviewType {
  normal
  std

  @@schema("contracts")
}

model Contract {
  id            String        @id @default(uuid())
  title         String
  securityLevel SecurityLevel @default(secure)
  reviewType    ReviewType    @default(normal)

  // 4단 분류 (MVP 컬럼, 후속 ContractCategory 트리로 정규화)
  party    String?
  catMajor String?
  catMinor String?
  catSub   String?

  // requester/owner는 현재 mock 사용자 id라 FK 미연결. createdById만 실제 User FK.
  requesterId String?
  ownerId     String?
  createdById String

  periodStart DateTime?
  periodEnd   DateTime?
  dueDate     DateTime?

  schemaVersion Int  @default(1)
  details       Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy      User           @relation(fields: [createdById], references: [id])
  counterparties Counterparty[]

  @@index([createdById])
  @@index([deletedAt])
  @@schema("contracts")
}

model Counterparty {
  id         String   @id @default(uuid())
  contractId String
  companyId  String
  partyType  String?
  snapshot   Json
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([contractId])
  @@index([companyId])
  @@schema("shared")
}
