generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["users", "companies", "contracts", "shared"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  contracts           Contract[]

  @@schema("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("users")
}

enum CompanyType {
  company
  individual

  @@schema("companies")
}

model Company {
  id            String      @id @default(uuid())
  type          CompanyType @default(company)
  name          String
  bizNo         String      @unique
  ceo           String?
  phone         String?
  address       String?
  addressDetail String?
  managerName   String?
  managerPhone  String?
  managerEmail  String?
  createdAt     DateTime    @default(now())

  counterparties Counterparty[]

  @@index([name])
  @@schema("companies")
}

enum SecurityLevel {
  top
  secure
  normal

  @@schema("contracts")
}

enum ReviewType {
  normal
  std

  @@schema("contracts")
}

model Contract {
  id            String        @id @default(uuid())
  title         String
  securityLevel SecurityLevel @default(secure)
  reviewType    ReviewType    @default(normal)

  // 4단 분류 (MVP 컬럼, 후속 ContractCategory 트리로 정규화)
  party    String?
  catMajor String?
  catMinor String?
  catSub   String?

  // requester/owner는 현재 mock 사용자 id라 FK 미연결. createdById만 실제 User FK.
  requesterId String?
  ownerId     String?
  createdById String

  periodStart DateTime?
  periodEnd   DateTime?
  dueDate     DateTime?

  schemaVersion Int  @default(1)
  details       Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy      User           @relation(fields: [createdById], references: [id])
  counterparties Counterparty[]
  approvalLines  ApprovalLine[]
  files          File[]
  references     ContractReference[]

  @@index([createdById])
  @@index([deletedAt])
  @@schema("contracts")
}

model Counterparty {
  id         String   @id @default(uuid())
  contractId String
  companyId  String
  partyType  String?
  snapshot   Json
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([contractId])
  @@index([companyId])
  @@schema("shared")
}

enum ApproverType {
  draft
  approve
  agree
  refer

  @@schema("shared")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@schema("shared")
}

enum StepStatus {
  pending
  approved
  rejected

  @@schema("shared")
}

// 결재선: 계약 1건당 1개(현재). 폼 approvers 스냅샷을 단계로 정규화.
// ERD 는 폴리모픽(ownerType/ownerId)이나, MVP 는 Counterparty 와 동일하게 contractId 직접 FK 로 둔다(§9 수렴 항목).
model ApprovalLine {
  id         String         @id @default(uuid())
  contractId String
  status     ApprovalStatus @default(pending)
  createdAt  DateTime       @default(now())

  contract Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  steps    ApprovalStep[]

  @@index([contractId])
  @@schema("shared")
}

model ApprovalStep {
  id        String       @id @default(uuid())
  lineId    String
  stepOrder Int
  name      String
  dept      String
  type      ApproverType
  status    StepStatus   @default(pending)

  line ApprovalLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@schema("shared")
}

enum FileRole {
  contract // 계약서
  attach // 첨부/별첨
  ref // 참고서류

  @@schema("shared")
}

// 첨부 파일 메타데이터. MVP 는 메타 행만(실제 업로드 전까지 size/mimeType/storageKey 는 null, meta 표시문자열 보존).
// ERD 는 폴리모픽(ownerType/ownerId)이나 MVP 는 Counterparty/ApprovalLine 과 동일하게 contractId 직접 FK(§9 수렴 항목).
model File {
  id         String   @id @default(uuid())
  contractId String
  role       FileRole
  name       String
  meta       String?
  size       Int?
  mimeType   String?
  storageKey String?
  sortOrder  Int
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@schema("shared")
}

enum CcType {
  user
  dept

  @@schema("shared")
}

// 참조수신자(cc). ccType(user/dept) + isSecret 두 축으로 폼 3개 배열을 통합.
// refId 는 현재 디렉토리 mock id, name 은 표시 스냅샷. 비밀 참조자 읽기 마스킹/ACL 은 후속(§6).
model ContractReference {
  id         String   @id @default(uuid())
  contractId String
  ccType     CcType
  isSecret   Boolean  @default(false)
  refId      String
  name       String
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@schema("shared")
}
