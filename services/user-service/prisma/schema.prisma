generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["users", "companies", "contracts", "shared", "ai"]
}

enum TenantPlan {
  enterprise
  pro
  starter

  @@schema("users")
}

enum TenantStatus {
  active
  trial
  suspended

  @@schema("users")
}

enum TenantRole {
  general
  contractManager
  inHouseCounsel
  outsideCounsel
  sealManager

  @@schema("users")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  plan        TenantPlan   @default(starter)
  status      TenantStatus @default(active)
  // status=trial 일 때 체험판 만료 시각. active/suspended 면 null 권장(앱 레벨 관리, DB 강제 없음).
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())

  memberships UserTenant[]
  invitations Invitation[]

  @@schema("users")
}

// 고객사 초대 (Spec 4). tokenHash = sha256(raw) — PasswordResetToken 과 동일 방식.
// 유효 초대 = acceptedAt null && canceledAt null && expiresAt > now.
model Invitation {
  id          String     @id @default(uuid())
  tenantId    String
  email       String
  role        TenantRole @default(general)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  canceledAt  DateTime?
  createdAt   DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@schema("users")
}

model UserTenant {
  id       String     @id @default(uuid())
  userId   String
  tenantId String
  role     TenantRole @default(general)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@schema("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime @default(now())

  users     User[]
  contracts Contract[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@schema("users")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  isSystemAdmin Boolean  @default(false)
  departmentId  String?
  emailNotify   Boolean  @default(true)
  // 알림 종류별 받기 — 결재(차례·반려·완료·참조) / 코멘트(나를 언급, 끄면 이메일도 안 보냄).
  notifyApproval Boolean @default(true)
  notifyComment  Boolean @default(true)
  // 계약 만료 임박 알림(90·30·7일 전) 받기.
  notifyContractExpiry Boolean @default(true)
  // 프로필 사진 R2 키(avatars/<userId>/<uuid>.<ext>). 올릴 때마다 새 키라 이미지 캐시가 자연히 갱신된다.
  avatarKey     String?
  createdAt     DateTime @default(now())

  department          Department?          @relation(fields: [departmentId], references: [id])
  passwordResetTokens PasswordResetToken[]
  tenantMemberships   UserTenant[]
  createdContracts    Contract[]           @relation("ContractCreatedBy")
  requestedContracts  Contract[]           @relation("ContractRequester")
  ownedContracts      Contract[]           @relation("ContractOwner")
  authoredComments    Comment[]            @relation("CommentAuthor")
  commentMentions     CommentMention[]     @relation("MentionedUser")
  submittedApprovalLines ApprovalLine[]    @relation("SubmittedApprovalLines")
  approvalSteps       ApprovalStep[]       @relation("UserApprovalSteps")

  @@index([departmentId])
  @@schema("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("users")
}

enum CompanyType {
  company
  individual

  @@schema("companies")
}

model Company {
  id            String      @id @default(uuid())
  type          CompanyType @default(company)
  name          String
  bizNo         String
  tenantId      String
  ceo           String?
  phone         String?
  address       String?
  addressDetail String?
  managerName   String?
  managerPhone  String?
  managerEmail  String?
  createdAt     DateTime    @default(now())

  counterparties Counterparty[]

  @@unique([tenantId, bizNo])
  @@index([name])
  @@index([tenantId])
  @@schema("companies")
}

enum SecurityLevel {
  top
  secure
  normal

  @@schema("contracts")
}

enum ReviewType {
  normal
  std

  @@schema("contracts")
}

enum ContractStatus {
  draft // 임시 저장
  unassigned // 미배정
  assigning // 배정 중
  legalReview // 법무 검토 중
  requesterReview // 요청자 검토 중
  reviewDone // 검토 완료
  signing // 체결 진행
  signed // 체결 완료
  fulfilling // 계약 이행
  closed // 계약 종료

  @@schema("contracts")
}

// 계약 종료 사유. closed 가 될 때 확정(그 전엔 Contract.closedReason = null).
enum ContractClosedReason {
  completed // 의무를 마쳐 정상 종료
  expired // 기간 만료
  renewed // 갱신 계약 체결로 종료
  terminated // 중도 해지

  @@schema("contracts")
}

// 계약 분류 트리(자기참조). 루트=parentId NULL. slug=계층 경로 dot-notation 영문 안정 식별자(전역 unique).
model ContractCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  tenantId  String
  sortOrder Int?
  createdAt DateTime @default(now())

  parent    ContractCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ContractCategory[] @relation("CategoryTree")
  contracts Contract[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([tenantId])
  @@schema("contracts")
}

model Contract {
  id            String         @id @default(uuid())
  code          String         @unique
  title         String
  status        ContractStatus @default(unassigned)
  securityLevel SecurityLevel  @default(secure)
  reviewType    ReviewType     @default(normal)

  // 분류: ContractCategory 트리 FK + 라벨 스냅샷(전체 경로 "대 > 중 > 소"). party 는 본사/법인계약 구분(현행 유지).
  party         String?
  categoryId    String?
  categoryLabel String?

  // requester/owner/createdBy 모두 실제 User FK. department는 작성 부서.
  requesterId  String?
  ownerId      String?
  createdById  String
  departmentId String?

  tenantId String

  periodStart DateTime?
  periodEnd   DateTime?
  dueDate     DateTime?
  signedAt    DateTime? // 실제 서명 완료일. signed 상태 진입 시 확정.

  // 종료 정보 — closed 가 될 때 채운다. closedAt 은 실제 종료일(해지일·갱신 계약 체결일).
  closedReason ContractClosedReason?
  closedAt     DateTime?
  closedNote   String?
  // 갱신·변경·해지 요청이 가리키는 원 계약(자기 참조). 원 계약이 지워지면 연결만 끊는다.
  originContractId String?

  schemaVersion Int  @default(1)
  details       Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy      User                @relation("ContractCreatedBy", fields: [createdById], references: [id])
  requester      User?               @relation("ContractRequester", fields: [requesterId], references: [id])
  owner          User?               @relation("ContractOwner", fields: [ownerId], references: [id])
  department     Department?         @relation(fields: [departmentId], references: [id])
  category       ContractCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  counterparties Counterparty[]
  files          File[]
  references     ContractReference[]
  comments       Comment[]
  originContract   Contract?  @relation("ContractOrigin", fields: [originContractId], references: [id], onDelete: SetNull)
  derivedContracts Contract[] @relation("ContractOrigin")

  @@index([tenantId])
  @@index([originContractId])
  @@index([createdById])
  @@index([requesterId])
  @@index([ownerId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([deletedAt])
  @@schema("contracts")
}

// 계약 검토 코멘트(평면 스레드). 계약 1:N 종속(contractId 직접 FK Cascade).
// authorId → users.User(cross-schema, NO ACTION — 작성자 삭제 정책은 보수적). role 은 작성 시점 작성자 role 스냅(표시용).
model Comment {
  id         String    @id @default(uuid())
  contractId String
  authorId   String
  role       String
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author      User             @relation("CommentAuthor", fields: [authorId], references: [id])
  mentions    CommentMention[]
  attachments File[]           @relation("CommentFiles")

  @@index([contractId])
  @@index([deletedAt])
  @@schema("contracts")
}

// 코멘트 멘션(정규 소유). 후보=계약 관련자 한정. commentId FK Cascade(하드삭제 정리),
// userId → users.User(cross-schema, NO ACTION — Comment.author 선례). (commentId,userId) unique 로 중복 멘션 방지.
model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("MentionedUser", fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@schema("contracts")
}

model Counterparty {
  id         String   @id @default(uuid())
  contractId String
  companyId  String
  partyType  String?
  snapshot   Json
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([contractId])
  @@index([companyId])
  @@schema("shared")
}

enum ApproverType {
  draft
  approve
  agree
  refer

  @@schema("shared")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@schema("shared")
}

enum StepStatus {
  pending
  approved
  rejected

  @@schema("shared")
}

// 결재 라인(범용): 폴리모픽 (targetType, targetId) — "contract" 외 도메인도 재사용.
// 상신 시점에만 생성되며(상신 전 결재선은 대상 도메인 데이터), 반려 후 재상신 시 새 라인(이전 = 이력).
// tenantId 는 상신 시점 스냅샷 — 대기함 테넌트 격리 + 알림 생성용.
model ApprovalLine {
  id            String         @id @default(uuid())
  targetType    String
  targetId      String
  title         String
  status        ApprovalStatus @default(pending)
  tenantId      String
  submittedById String
  submittedAt   DateTime       @default(now())
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  submittedBy User           @relation("SubmittedApprovalLines", fields: [submittedById], references: [id])
  steps       ApprovalStep[]

  @@index([targetType, targetId])
  @@index([status])
  @@schema("shared")
}

// 결재 스텝: userId = 실제 결재자(기안/참조 포함, null = 사용자 미연결 스냅샷).
// draft 는 상신 시 approved 로 생성, refer 는 승인 대상 아님(알림 전용).
model ApprovalStep {
  id        String       @id @default(uuid())
  lineId    String
  stepOrder Int
  userId    String?
  name      String
  dept      String
  type      ApproverType
  status    StepStatus   @default(pending)
  comment   String?
  decidedAt DateTime?

  line ApprovalLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user User?        @relation("UserApprovalSteps", fields: [userId], references: [id])

  @@index([lineId])
  @@index([userId, status])
  @@schema("shared")
}

enum FileRole {
  contract // 계약서
  attach // 첨부/별첨
  ref // 참고서류
  signed // 최종 서명본(체결 완료본)

  @@schema("shared")
}

// 첨부 파일 메타데이터. MVP 는 메타 행만(실제 업로드 전까지 size/mimeType/storageKey 는 null, meta 표시문자열 보존).
// ERD 는 폴리모픽(ownerType/ownerId)이나 MVP 는 Counterparty/ApprovalLine 과 동일하게 contractId 직접 FK(§9 수렴 항목).
model File {
  id         String   @id @default(uuid())
  // 계약 첨부면 contractId, 자문 첨부면 adviceId — 둘 중 하나만 채운다(앱 레벨 보장).
  contractId String?
  adviceId   String?
  commentId  String?
  tenantId   String
  role       FileRole
  name       String
  meta       String?
  size       Int?
  mimeType   String?
  storageKey String?
  checksum   String?
  sortOrder  Int
  createdAt  DateTime @default(now())

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  advice   Advice?   @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  comment  Comment?  @relation("CommentFiles", fields: [commentId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([adviceId])
  @@index([commentId])
  @@index([tenantId])
  @@schema("shared")
}

enum CcType {
  user
  dept

  @@schema("shared")
}

// 참조수신자(cc). ccType(user/dept) + isSecret 두 축으로 폼 3개 배열을 통합.
// refId 는 현재 디렉토리 mock id, name 은 표시 스냅샷. 비밀 참조자 읽기 마스킹/ACL 은 후속(§6).
model ContractReference {
  id         String   @id @default(uuid())
  contractId String
  ccType     CcType
  isSecret   Boolean  @default(false)
  refId      String
  name       String
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@schema("shared")
}

enum AuditAction {
  create
  update
  delete
  transition
  view
  compare_report_download
  // 삭제된 계약 복구(시스템 관리자).
  restore

  @@schema("shared")
}

// 폴리모픽 공용 감사 로그(§3.4). targetType/targetId 로 대상 엔티티를 지칭(MVP 는 "Contract").
// DB FK 없음 — 앱 레벨 무결성(cross-schema FK 회피, 향후 Company/File/User 감사 시 재마이그레이션 불필요).
// detail 에 securityLevel·from→to·변경 필드 등 가변 메타를 흡수(별도 컬럼 없음).
model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  actorId    String
  targetType String
  targetId   String
  tenantId   String
  detail     Json?
  at         DateTime    @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([tenantId])
  @@schema("shared")
}

// 폴리모픽 인앱 알림(멘션 알림 등). AuditLog 선례 동일: targetType/targetId 로 대상 지칭, detail 에 가변 메타(contractId·preview 등).
// DB FK 없음 — 앱 레벨 무결성(cross-schema FK 회피, recipientId/actorId/targetId 는 String 만).
// readAt 으로 읽음 상태(null=안읽음). 인덱스: 안읽음 카운트([recipientId, readAt]) + 목록 정렬([recipientId, createdAt]).
model Notification {
  id          String    @id @default(uuid())
  recipientId String
  type        String
  actorId     String
  targetType  String
  targetId    String
  tenantId    String
  detail      Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([tenantId])
  @@schema("shared")
}

enum SupportStatus {
  open // 답변 대기
  answered // 답변 옴
  closed // 종료

  @@schema("shared")
}

enum SupportAuthorRole {
  user
  admin

  @@schema("shared")
}

// 문의 스레드 — AI 비서 "문의" 탭에서 만들고, 관리자 콘솔에서 답한다.
// userId/tenantId 는 다른 스키마를 가리켜 FK 없음(AuditLog·Notification 선례). 메시지는 같은 스키마라 관계를 건다.
model SupportThread {
  id            String           @id @default(uuid())
  tenantId      String
  userId        String
  subject       String
  status        SupportStatus    @default(open)
  // 오류 문의면 화면 주소·오류 메시지·앱 버전 등(사용자가 쓴 내용과 별개).
  context       Json?
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([tenantId])
  @@schema("shared")
}

model SupportMessage {
  id         String            @id @default(uuid())
  threadId   String
  thread     SupportThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  authorRole SupportAuthorRole
  body       String
  createdAt  DateTime          @default(now())

  @@index([threadId, createdAt])
  @@schema("shared")
}

model AiProviderCredential {
  id            String   @id @default(uuid())
  userId        String   @unique   // 개인별 — 테넌트 공용 아님
  tenantId      String             // 소속 테넌트(감사·조회용 스냅샷)
  provider      String             // "openai"
  model         String             // 선택된 모델 id
  encryptedApiKey String
  lastVerifiedAt  DateTime?        // 저장 시 검증 호출 성공 시각
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@schema("ai")
}

model AiAnalysis {
  id               String   @id @default(uuid())
  tenantId         String
  targetType       String   // "contract"
  targetId         String
  kind             String   // "precheck" | "risk" | "submitBriefing" | "approvalBriefing"
  status           String   // "pending" | "running" | "succeeded" | "failed" | "skipped"
  model            String?
  triggeredByUserId String  // 이 결과를 생성한 자격증명의 소유자(표시: "OOO님의 AI 설정으로 생성됨")
  input            Json     // 분석에 넘긴 입력 스냅샷(재현/디버깅용)
  result           Json?
  errorMessage     String?
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([targetType, targetId, kind])
  @@index([tenantId, status])
  @@schema("ai")
}

// ── 법률자문 ─────────────────────────────────────────────────────────────
// 요청자가 법무팀에 묻고(질의) 담당자가 답하는(회신) 업무. 계약과 같은 테넌트·보안등급 체계를 쓴다.
// 사람 id(requester/owner/createdBy/author)는 SupportThread 선례대로 FK 없이 저장하고 이름은 한 번에 조회한다.
enum AdviceStatus {
  requestApproval // 요청 결재 중(부서장 등) — 승인되면 접수
  requestRejected // 요청 결재 반려 — 요청자가 결재선을 고쳐 다시 올린다
  received // 접수(담당 배정 전)
  reviewing // 법무 검토 중
  waitingRequester // 추가 질의 — 요청자 답변 대기
  answerApproval // 회신 결재 중 — 승인되면 요청자에게 회신이 공개된다
  answered // 회신 완료
  closed // 종결

  @@schema("contracts")
}

enum AdviceRegion {
  domestic // 국내
  overseas // 해외
  both // 국내외

  @@schema("contracts")
}

enum AdviceMessageKind {
  followup // 담당자 → 요청자 추가 질의
  reply // 요청자 답변·추가 설명
  answer // 담당자 정식 회신

  @@schema("contracts")
}

model Advice {
  id            String        @id @default(uuid())
  // 관리번호: ADV-{YYYY}-{4자리}
  code          String        @unique
  title         String
  status        AdviceStatus  @default(received)
  securityLevel SecurityLevel @default(secure)
  categories    String[]
  region        AdviceRegion  @default(domestic)
  countries     String[]

  requesterId  String
  ownerId      String?
  createdById  String
  tenantId     String

  // 사안의 배경·질의의 요지는 에디터 HTML(표시할 때 정화한다).
  background String
  question   String
  etcRequest String?
  dueDate    DateTime?
  // 참조수신자·관련 프로젝트·상대방 등 조회 조건으로 쓰지 않는 입력값.
  details    Json

  answeredAt DateTime?
  closedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages AdviceMessage[]
  files    File[]

  @@index([tenantId, status])
  @@index([requesterId])
  @@index([ownerId])
  @@index([createdById])
  @@schema("contracts")
}

// 회신 결재를 거치는 회신은 승인 전까지 요청자에게 보이지 않는다.
enum AdviceMessageState {
  published // 공개
  pendingApproval // 결재 중
  rejected // 결재 반려

  @@schema("contracts")
}

model AdviceMessage {
  id        String            @id @default(uuid())
  adviceId  String
  authorId  String
  kind      AdviceMessageKind
  state     AdviceMessageState @default(published)
  body      String
  createdAt DateTime          @default(now())

  advice Advice @relation(fields: [adviceId], references: [id], onDelete: Cascade)

  @@index([adviceId, createdAt])
  @@schema("contracts")
}
